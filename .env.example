# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# http  = remote server for claude.ai / ChatGPT / Claude Code (Docker default)
# stdio = local process for Claude Desktop / Claude Code
TRANSPORT=http
PORT=3000
# Externally reachable base URL (https). The MCP endpoint is PUBLIC_URL/mcp.
PUBLIC_URL=https://mcp.example.com
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Access level
# ---------------------------------------------------------------------------
# readonly  = only read tools exist and Google is asked for read-only scopes (default)
# readwrite = write tools become available to connections you approve with write access
ACCESS_MODE=readonly
# Optional: limit which write families exist in readwrite mode (default: all)
# gsc, indexing, ga4_admin, ga4_audiences_streams, gtm, gtm_publish
# (gtm_publish = publish Tag Manager versions to the LIVE website)
WRITE_TOOLSETS=
# Optional: which Google products to expose (default: all): gsc, ga4, gtm
ENABLED_SERVICES=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Password you type when approving a new client connection and on /setup (min 16 chars).
# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=
# Encrypts the stored Google refresh token. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Optional static bearer tokens for headless clients: label=token:read or label=token:read+write
# Generate tokens with: openssl rand -base64 32
MCP_API_KEYS=

# ---------------------------------------------------------------------------
# Google credentials
# ---------------------------------------------------------------------------
# oauth           = sign in once as yourself at PUBLIC_URL/setup (recommended)
# service_account = use a service account key; add its email to each GSC/GA4 property
GOOGLE_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for TRANSPORT=http in oauth mode: the only Google account that may be connected
GOOGLE_OWNER_EMAIL=
# Service account mode: raw JSON, a file path, or base64-encoded JSON
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Optional allowlists (comma separated). Empty = everything the Google identity can see.
# ---------------------------------------------------------------------------
ALLOWED_GSC_SITES=
ALLOWED_GA4_PROPERTIES=
# Narrower lists for write tools (must also be inside the read lists when those are set)
WRITE_ALLOWED_GSC_SITES=
WRITE_ALLOWED_GA4_PROPERTIES=
# Tag Manager containers by public ID (GTM-ABC123) or numeric container ID
ALLOWED_GTM_CONTAINERS=
WRITE_ALLOWED_GTM_CONTAINERS=
